:host { display: contents; }
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10,6,4,.62);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 70;
}
.mask.center {
  align-items: center;
  padding: 24px;
}
.sheet {
  width: 100%;
  background: #241812;
  border-radius: 16px 16px 0 0;
  padding: 8px 0 calc(12px + env(safe-area-inset-bottom));
}
.dialog {
  width: 100%;
  max-width: 320px;
  background: #241812;
  border-radius: 12px;
  padding: 20px 16px 12px;
}
.sheet-grab {
  width: 36px;
  height: 4px;
  background: #5a3228;
  border-radius: 2px;
  margin: 6px auto 4px;
}
.sheet-h {
  text-align: center;
  font-weight: 700;
  padding: 8px 16px 12px;
  color: #fff4ec;
}

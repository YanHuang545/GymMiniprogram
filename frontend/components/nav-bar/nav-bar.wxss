:host {
  display: block;
}
.hd {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  box-sizing: border-box;
  border-bottom: 1px solid #3d241c;
}
.hd-inner {
  height: 44px;
  display: flex;
  align-items: center;
  min-width: 0;
}
.hd-left, .hd-right {
  width: 72px;
  flex: none;
  display: flex;
  align-items: center;
}
.hd-title {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.hd-title-text {
  font-size: 16px;
  font-weight: 650;
  line-height: 44px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #fff4ec;
}
.icon-btn {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

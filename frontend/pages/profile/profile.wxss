.wx-login-card {
  margin: 12px 16px 0;
  padding: 28px 20px 24px;
  border-radius: 12px;
  background: #241812;
  border: 1px solid #3d241c;
}

.wx-login-title {
  text-align: center;
  font-size: 20px;
  font-weight: 700;
  color: #fff4ec;
  margin-bottom: 6px;
}

.wx-login-sub {
  text-align: center;
  font-size: 13px;
  color: #b07a5e;
  line-height: 1.5;
  margin-bottom: 20px;
}

.login-ava-btn {
  display: block;
  width: 88px !important;
  min-width: 88px;
  max-width: 88px;
  height: 88px;
  padding: 0 !important;
  margin: 0 auto 16px;
  overflow: hidden;
  border-radius: 50%;
  background: transparent !important;
  background-color: transparent !important;
  border: none;
  line-height: 0;
}

.login-ava-btn::after {
  display: none;
}

.login-ava-btn .login-ava {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  display: block;
}

.login-ava-hint {
  display: block;
  text-align: center;
  font-size: 12px;
  color: #b07a5e;
  margin-bottom: 16px;
}

.wx-nick {
  width: 100%;
  height: 44px;
  margin: 0 0 16px;
  padding: 0 12px;
  border-radius: 8px;
  background: #331c16;
  color: #fff4ec;
  font-size: 15px;
}

.wx-login-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border-radius: 8px;
  background: #07c160;
  color: #fff;
  font-size: 16px;
  font-weight: 650;
}

.pf-ava-wrap {
  position: relative;
  flex: none;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(36, 24, 18, 0.35);
  box-shadow: 0 0 0 2px rgba(255, 244, 236, 0.45);
}

.pf-ava-wrap .pf-ava {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: block;
}

.pf-ava-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 64px !important;
  min-width: 64px;
  max-width: 64px;
  height: 64px;
  padding: 0 !important;
  margin: 0;
  opacity: 0;
  border: none;
  background: transparent !important;
}

.pf-ava-hit::after {
  display: none;
}

.pf-name-input {
  width: 100%;
  height: 24px;
  min-height: 24px;
  padding: 0;
  margin: 0;
  background: transparent;
  color: #fff;
  font-size: 18px;
  font-weight: 700;
  line-height: 24px;
}

.pf-name-ph {
  color: rgba(255, 244, 236, 0.45);
  font-weight: 500;
}

.logout-btn {
  margin: 24px 16px 8px;
  height: 48px;
  border-radius: 12px;
  background: #241812;
  border: 1px solid #3d241c;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn-text {
  color: #e64340;
  font-size: 16px;
  font-weight: 500;
}

<view class="page-root" style="padding-top: {{navBarHeight}}px;">
  <view class="page-body tab-pad">
    <view class="profile-hero" bindtap="onAuth">
      <image class="pf-ava" src="{{avatar}}" mode="aspectFill"></image>
      <view class="pf-main">
        <text class="pf-name">{{name}}</text>
        <view style="font-size:12px;opacity:.9;margin-top:4px;"><text>欢迎来到燃练</text></view>
      </view>
    </view>

    <view class="card asset-bar">
      <view class="asset-btn" data-path="/my-packages" bindtap="goPath">
        <text class="asset-num">{{pkg}}</text>
        <text class="asset-lab">课包剩余(次)</text>
      </view>
      <view class="asset-btn" data-path="/coupons" bindtap="goPath">
        <text class="asset-num">{{coupon}}</text>
        <text class="asset-lab">优惠券(张)</text>
      </view>
    </view>

    <view class="card train-card">
      <text>{{trainText}}</text>
    </view>

    <view class="card menu-card">
      <view class="list-row" data-path="/bookings" bindtap="goPath">
        <view class="left">
          <icon-mask name="calendar-days" size="20" color="#fff4ec"></icon-mask>
          <text class="left-text">我的预约</text>
        </view>
        <icon-mask name="chevron-right" size="18" color="#b07a5e"></icon-mask>
      </view>
      <view class="list-row" data-path="/orders" bindtap="goPath">
        <view class="left">
          <icon-mask name="credit-card" size="20" color="#fff4ec"></icon-mask>
          <text class="left-text">我的订单</text>
        </view>
        <icon-mask name="chevron-right" size="18" color="#b07a5e"></icon-mask>
      </view>
      <view class="list-row" data-path="/enterprise" bindtap="goPath">
        <view class="left">
          <icon-mask name="building-2" size="20" color="#fff4ec"></icon-mask>
          <text class="left-text">企业服务</text>
        </view>
        <icon-mask name="chevron-right" size="18" color="#b07a5e"></icon-mask>
      </view>
      <view class="list-row" bindtap="contactCs">
        <view class="left">
          <icon-mask name="message-circle" size="20" color="#fff4ec"></icon-mask>
          <text class="left-text">联系客服</text>
        </view>
        <icon-mask name="chevron-right" size="18" color="#b07a5e"></icon-mask>
      </view>
      <view class="list-row" style="border:none;" data-path="/settings" bindtap="goPath">
        <view class="left">
          <icon-mask name="settings" size="20" color="#fff4ec"></icon-mask>
          <text class="left-text">设置</text>
        </view>
        <icon-mask name="chevron-right" size="18" color="#b07a5e"></icon-mask>
      </view>
    </view>
  </view>
</view>

<view class="page-root" style="padding-top: {{navBarHeight}}px;">
  <nav-bar title="训练营详情" showBack="{{true}}"></nav-bar>
  <view class="page-body cta-pad">
    <empty-state wx:if="{{missing}}" text="训练营不存在"></empty-state>
    <block wx:else>
      <view class="cover-wrap">
        <image class="cover" src="{{m.cover}}" mode="aspectFill"></image>
      </view>
      <view class="pad">
        <text class="detail-title">{{m.name}}</text>
        <view style="margin-top:8px;">
          <text wx:for="{{m.tags}}" wx:key="*this" class="tag">{{item}}</text>
        </view>
      </view>
      <view class="card info-card">
        <text class="long-text">开营 {{startText}} · 共 {{m.weeks}} 周
课表 {{schedule}}
教练 {{coachName}}
剩余名额 {{left}}</text>
      </view>
      <view class="card rule-card">
        <text class="long-text">开营前可自助取消退款；开营后不能自行取消，请联系门店。</text>
      </view>
      <view class="article"><text class="long-text">{{m.intro}}</text></view>
    </block>
  </view>
  <view class="sticky-cta" wx:if="{{!missing}}">
    <text class="price">{{priceText}}</text>
    <view class="btn btn-lg {{ctaDisabled ? 'btn-disabled' : 'btn-primary'}}" bindtap="enroll"><text>{{ctaText}}</text></view>
  </view>
  <overlay-mask show="{{overlayShow}}" bind:close="closeOverlay">
    <view class="sheet-h"><text>授权手机号</text></view>
    <view class="pad"><text class="muted">预约和支付需要手机号，用于上课提醒和售后联系。</text></view>
    <view class="pad">
      <view class="btn btn-primary btn-lg" style="width:100%;" bindtap="mockPhone"><text>使用微信手机号</text></view>
      <view class="btn btn-ghost btn-lg" style="width:100%;margin-top:8px;" bindtap="closeOverlay"><text>取消</text></view>
    </view>
  </overlay-mask>
</view>

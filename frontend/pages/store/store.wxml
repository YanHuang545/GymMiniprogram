<view class="page-root" style="padding-top: {{navBarHeight}}px;">
  <nav-bar title="{{title}}" showBack="{{true}}"></nav-bar>
  <view class="page-body cta-pad">
    <view class="gallery">
      <image
        wx:for="{{gallery}}"
        wx:key="*this"
        class="g-img"
        src="{{item}}"
        mode="aspectFill"
        data-url="{{item}}"
        bindtap="preview"
      ></image>
    </view>
    <view class="pad">
      <text class="detail-title">{{s.name}}</text>
      <view class="muted" style="margin-top:6px;">
        <text wx:for="{{s.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>
    <view class="card info-card">
      <text class="long-text">地址 {{s.address}}
电话 {{s.phone}}
营业 {{s.hours}}
距离 {{s.dist}}</text>
    </view>
    <view class="pad" style="display:flex;gap:8px;">
      <view class="btn btn-ghost" bindtap="callPhone"><text>拨打电话</text></view>
      <view class="btn btn-ghost" bindtap="copyAddr"><text>复制地址</text></view>
    </view>
  </view>
  <view class="sticky-cta">
    <text class="muted">{{hours}}</text>
    <view class="btn btn-primary btn-lg" bindtap="goSchedule"><text>看本店课表</text></view>
  </view>
</view>

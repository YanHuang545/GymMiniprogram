<view class="page-root" style="padding-top: {{navBarHeight}}px;">
  <nav-bar title="预约私教" showBack="{{true}}"></nav-bar>
  <view class="page-body cta-pad">
    <empty-state wx:if="{{missing}}" text="请先选择教练"></empty-state>
    <block wx:else>
      <view class="card session-card" style="margin:12px 16px;">
        <image class="avatar" src="{{c.avatar}}" mode="aspectFill"></image>
        <view class="mid">
          <text class="mid-title">{{c.name}}</text>
          <view class="muted"><text>私教 · 扣 1 次课包</text></view>
        </view>
      </view>
      <scroll-view scroll-x enable-flex class="date-strip" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{dates}}"
          wx:key="key"
          class="date-chip {{slotDate === item.key ? 'is-on' : ''}}"
          data-id="{{item.key}}"
          bindtap="onDate"
        >
          <text class="d-num">{{item.num}}</text>
          <text>{{item.lab}}</text>
        </view>
      </scroll-view>
      <view class="slot-grid">
        <view
          wx:for="{{slots}}"
          wx:key="id"
          class="slot {{item.busy ? 'is-busy' : ''}} {{item.on ? 'is-on' : ''}}"
          data-id="{{item.id}}"
          data-busy="{{item.busy}}"
          bindtap="pickSlot"
        ><text>{{item.id}}</text></view>
      </view>
      <view class="muted" style="text-align:center;"><text>灰色 = 已被约走</text></view>
    </block>
  </view>
  <view class="sticky-cta" wx:if="{{!missing}}">
    <text class="muted">{{remainText}}</text>
    <view class="btn btn-primary btn-lg" bindtap="confirm"><text>确认预约</text></view>
  </view>
</view>

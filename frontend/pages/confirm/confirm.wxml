<view class="page-root" style="padding-top: {{navBarHeight}}px;">
  <nav-bar title="确认订单" showBack="{{true}}"></nav-bar>
  <view class="page-body cta-pad">
    <empty-state wx:if="{{missing}}" text="没有待确认的订单"></empty-state>
    <block wx:else>
      <view class="card" style="margin:12px 16px;overflow:hidden;width:auto;">
        <view wx:for="{{rows}}" wx:key="k" class="list-row">
          <text class="muted">{{item.k}}</text>
          <text class="row-val">{{item.v}}</text>
        </view>
      </view>
      <view wx:if="{{showCoupon}}" class="card list-row" style="margin:8px 16px;width:auto;border-radius:12px;" bindtap="pickCoupon">
        <text>优惠券</text>
        <text style="color:#ff4a1a;">{{couponLine}}</text>
      </view>
      <view class="card rule-card"><text class="long-text">{{rule}}</text></view>
    </block>
  </view>
  <view class="sticky-cta" wx:if="{{!missing}}">
    <view class="muted">应付 <text class="price" style="font-size:20px;">{{payText}}</text></view>
    <view class="btn btn-primary btn-lg" bindtap="goPay"><text>{{ctaText}}</text></view>
  </view>
  <overlay-mask show="{{overlayShow}}" bind:close="closeOverlay">
    <block wx:if="{{overlayMode === 'coupon'}}">
      <view class="sheet-h"><text>选择优惠券</text></view>
      <view wx:for="{{couponItems}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="useCoupon">
        <text>{{item.name}}</text>
      </view>
    </block>
    <block wx:elif="{{overlayMode === 'pay'}}">
      <view class="sheet-h"><text>微信支付（演示）</text></view>
      <view class="sheet-pay">
        <view class="muted"><text>应付</text></view>
        <view class="price" style="font-size:28px;margin:8px 0;"><text>{{payAmount}}</text></view>
        <view class="muted"><text>不会产生真实扣款，仅演示占名额与到账。</text></view>
      </view>
      <view class="pad">
        <view class="btn btn-primary btn-lg {{paying ? 'btn-disabled' : ''}}" style="width:100%;" bindtap="confirmPay">
          <text>{{paying ? '支付中' : '确认支付'}}</text>
        </view>
        <view class="btn btn-ghost btn-lg" style="width:100%;margin-top:8px;" bindtap="closeOverlay"><text>取消</text></view>
      </view>
    </block>
  </overlay-mask>
</view>

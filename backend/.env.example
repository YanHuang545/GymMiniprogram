PORT=3000

# ----- 本机 MySQL（默认）-----
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=ROOT
# DB_NAME=gym_ranlian

# ----- 阿里云宝塔 MySQL（真机数据写入云库时用）-----
# 填宝塔「数据库」里 gym_ranlian 那一行，不是宝塔面板登录账号。
# 同时：该库访问权限允许远程 + 安全组放行 3306。
# DB_HOST=39.107.41.170
# DB_PORT=3306
# DB_USER=宝塔生成的用户名
# DB_PASSWORD=宝塔生成的密码
# DB_NAME=gym_ranlian
# 宝塔普通库用户没有建库权限时加上下面这行，再运行 npm run init-db
# DB_CREATE=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ROOT
DB_NAME=gym_ranlian
